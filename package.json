{
  "name": "wenmang",
  "version": "0.1.0",
  "description": "A Mandarin vocabulary and character-writing game with Leitner-box spaced repetition",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "watch": "vitest",
    "serve": "python3 -m http.server 8000",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:apply": "wrangler d1 migrations apply wenmang --remote",
    "db:local": "wrangler d1 migrations apply wenmang --local"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "vitest": "^2.1.9",
    "wrangler": "^4.128.0",
    "zod": "^4.5.4"
  },
  "dependencies": {
    "hanzi-writer": "^3.7.3"
  }
}
